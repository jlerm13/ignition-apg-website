---
// Direction 1: Ledger. Hallmark theme Almanac, macrostructure Split Studio.
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import Direction from "../../layouts/Direction.astro";
import { site, hero, problem, links } from "../../content/site";

const record = [
  { verb: "Collect", owner: "Data team" },
  { verb: "Check", owner: "Data team" },
  { verb: "Connect", owner: "Data team" },
  { verb: "Explain", owner: "Data team" },
];
---

<Direction direction="Ledger">
  <header class="nav">
    <div class="wrap nav__row">
      <a class="wordmark" href="#top">{site.name}</a>
      <a class="btn btn--small" href={links.booking}>{site.bookButton}</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="label">{hero.label}</p>
          <h1 class="hero__title">{hero.heading}</h1>
          <p class="hero__text">{hero.text}</p>
          <div class="hero__action">
            <a class="btn" href={links.booking}>{site.bookButton}</a>
            <p class="hero__under">{hero.underButton}</p>
          </div>
        </div>

        <figure class="record" aria-label="Who does what: the data team collects, checks, connects, and explains. Your coaches and clinicians decide.">
          <div class="record__head" aria-hidden="true">
            <span>Work</span><span>Owner</span>
          </div>
          <ul aria-hidden="true">
            {record.map((r) => (
              <li class="record__row">
                <span class="record__verb">{r.verb}</span>
                <span class="record__owner">{r.owner}</span>
              </li>
            ))}
            <li class="record__row record__row--staff">
              <span class="record__verb">Every decision</span>
              <span class="record__owner">Coaches and clinicians</span>
            </li>
          </ul>
        </figure>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="wrap problem__grid">
        <h2 id="problem-title" class="problem__title">{problem.heading}</h2>
        <div class="problem__body">
          <ul class="symptoms">
            {problem.symptoms.map((s) => <li>{s}</li>)}
          </ul>
          <div class="message">
            {problem.solution.map((line) => <p>{line}</p>)}
          </div>
        </div>
      </div>
    </section>
  </main>
</Direction>

<style is:global>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · theme: Almanac · enrichment: none · nav: N1a · footer: none (directions show hero and problem only) */
  :root {
    --color-paper: oklch(94% 0.008 245);
    --color-paper-2: oklch(91% 0.010 245);
    --color-paper-3: oklch(86% 0.012 240);
    --color-rule: oklch(74% 0.012 240);
    --color-rule-2: oklch(38% 0.018 240);
    --color-muted: oklch(46% 0.014 245);
    --color-neutral: oklch(28% 0.016 245);
    --color-ink: oklch(16% 0.020 245);
    --color-accent: oklch(38% 0.135 250);
    --color-on-accent: oklch(97% 0.006 245);
    --color-focus: oklch(38% 0.135 250);
    --font-display: "Hanken Grotesk Variable", ui-sans-serif, sans-serif;
    --font-body: "Hanken Grotesk Variable", ui-sans-serif, sans-serif;
    --font-label: "IBM Plex Mono", ui-monospace, monospace;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6.5rem;
    --page-max: 76rem;
    --page-gutter: clamp(1rem, 4vw, 3rem);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--page-gutter); }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .nav { border-bottom: 1px solid var(--color-rule); }
  .nav__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: 4.5rem; }
  .wordmark { font-weight: 700; font-size: 1.125rem; letter-spacing: -0.01em; color: var(--color-ink); text-decoration: none; white-space: nowrap; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0 var(--space-lg);
    background: var(--color-accent); color: var(--color-on-accent);
    font: 600 1rem/1 var(--font-body); text-decoration: none; white-space: nowrap;
    border: 1px solid var(--color-accent);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .btn:hover { background: var(--color-ink); border-color: var(--color-ink); }
  .btn:active { background: var(--color-neutral); }
  .btn--small { min-height: 2.75rem; padding: 0 var(--space-md); font-size: 0.9375rem; }

  .hero { padding-block: var(--space-2xl) var(--space-3xl); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-2xl); align-items: end; }
  .label { font: 500 0.8125rem/1.3 var(--font-label); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); margin: 0 0 var(--space-lg); }
  .hero__title { font: 600 clamp(2.5rem, 4.2vw + 1rem, 4.25rem)/1.03 var(--font-display); letter-spacing: -0.025em; margin: 0; max-width: 14ch; overflow-wrap: anywhere; min-width: 0; }
  .hero__text { font-size: 1.25rem; line-height: 1.5; color: var(--color-neutral); max-width: 40ch; margin: var(--space-lg) 0 var(--space-xl); }
  .hero__action { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
  .hero__under { margin: 0; font-size: 1rem; color: var(--color-muted); }

  .record { margin: 0; border: 1px solid var(--color-rule-2); background: var(--color-paper-2); }
  .record ul { list-style: none; margin: 0; padding: 0; }
  .record__head, .record__row { display: grid; grid-template-columns: 1fr auto; gap: var(--space-md); padding: var(--space-sm) var(--space-lg); }
  .record__head { font: 500 0.75rem/1.3 var(--font-label); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); border-bottom: 1px solid var(--color-rule-2); }
  .record__row { border-bottom: 1px solid var(--color-rule); align-items: baseline; }
  .record__verb { font-weight: 600; font-size: 1.125rem; }
  .record__owner { font: 400 0.875rem/1.3 var(--font-label); color: var(--color-muted); text-align: right; }
  .record__row--staff { border-bottom: 0; border-top: 2px solid var(--color-ink); background: var(--color-paper); }
  .record__row--staff .record__owner { color: var(--color-ink); font-weight: 500; }

  .problem { background: var(--color-paper-2); border-top: 1px solid var(--color-rule); padding-block: var(--space-3xl); }
  .problem__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); }
  .problem__title { font: 600 clamp(1.75rem, 1.6vw + 1rem, 2.5rem)/1.12 var(--font-display); letter-spacing: -0.015em; margin: 0; max-width: 18ch; overflow-wrap: anywhere; }
  .symptoms { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule-2); }
  .symptoms li { position: relative; padding: var(--space-md) 0 var(--space-md) var(--space-xl); border-bottom: 1px solid var(--color-rule); font-size: 1.1875rem; line-height: 1.45; max-width: 60ch; }
  .symptoms li::before { content: ""; position: absolute; left: 0; top: 1.55rem; width: 0.5rem; height: 0.5rem; background: var(--color-accent); }
  .closing { font-weight: 600; font-size: 1.1875rem; margin: var(--space-xl) 0 var(--space-lg); max-width: 60ch; }
  .message { border-top: 2px solid var(--color-ink); padding-top: var(--space-md); }
  .message p { margin: 0 0 var(--space-xs); font-size: 1.0625rem; color: var(--color-neutral); max-width: 60ch; }

  @media (max-width: 52rem) {
    .hero__grid, .problem__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .nav .btn--small { padding: 0 var(--space-sm); font-size: 0.875rem; }
  }
  @media (max-width: 30rem) {
    .nav .btn--small { display: none; }
    .hero { padding-top: var(--space-xl); }
    .hero .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
