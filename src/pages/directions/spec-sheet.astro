---
// Direction 3: Spec sheet. Hallmark theme Grid, macrostructure Marquee Hero.
import "@fontsource-variable/archivo";
import Direction from "../../layouts/Direction.astro";
import { site, hero, problem, links } from "../../content/site";
---

<Direction direction="Spec sheet">
  <header class="bar">
    <div class="wrap bar__row">
      <a class="wordmark" href="#top">{site.name}</a>
      <a class="btn btn--small" href={links.booking}>{site.bookButton}</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap grid hero__grid">
        <div class="ruler" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>
        <p class="label">{hero.label}</p>
        <h1 class="hero__title">{hero.heading}</h1>
        <div class="hero__side">
          <p class="hero__text">{hero.text}</p>
          <a class="btn" href={links.booking}>{site.bookButton}</a>
          <p class="hero__under">{hero.underButton}</p>
        </div>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="wrap grid">
        <h2 id="problem-title" class="problem__title">{problem.heading}</h2>
        <ol class="rows" role="list">
          {problem.symptoms.map((s) => <li class="row">{s}</li>)}
          <li class="row row--strong">{problem.closingLine}</li>
        </ol>
        <div class="message">
          {problem.departmentMessage.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </section>
  </main>
</Direction>

<style is:global>
  /* Hallmark · genre: editorial · macrostructure: Marquee Hero · theme: Grid · enrichment: exposed column grid · nav: N9 · footer: none (directions show hero and problem only) */
  :root {
    --color-paper: oklch(99% 0.003 255);
    --color-paper-2: oklch(97.2% 0.003 255);
    --color-rule: oklch(88% 0.004 255);
    --color-rule-2: oklch(72% 0.005 255);
    --color-muted: oklch(48% 0.006 255);
    --color-neutral: oklch(34% 0.006 255);
    --color-ink: oklch(16% 0.010 255);
    --color-on-ink: oklch(99% 0.003 255);
    --color-accent: oklch(55% 0.21 28);
    --color-focus: oklch(55% 0.21 28);
    --font-display: "Archivo Variable", "Helvetica Neue", ui-sans-serif, sans-serif;
    --font-body: "Archivo Variable", "Helvetica Neue", ui-sans-serif, sans-serif;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6.5rem;
    --page-max: 80rem;
    --page-gutter: clamp(1rem, 4vw, 3rem);
    --cols: 12;
    --gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--page-gutter); }
  .grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gap); }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .bar { border-bottom: 2px solid var(--color-ink); }
  .bar__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: 4rem; }
  .wordmark { font-weight: 800; font-size: 1.125rem; letter-spacing: -0.01em; color: var(--color-ink); text-decoration: none; white-space: nowrap; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0 var(--space-lg);
    background: var(--color-ink); color: var(--color-on-ink); border: 2px solid var(--color-ink);
    font: 700 1rem/1 var(--font-body); text-decoration: none; white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .btn:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .btn:active { background: var(--color-neutral); border-color: var(--color-neutral); }
  .btn--small { min-height: 2.75rem; padding: 0 var(--space-md); font-size: 0.9375rem; }

  /* The column grid is drawn as hairlines behind the hero: the page shows its own structure. */
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
    border-bottom: 1px solid var(--color-rule-2);
  }
  .hero__grid { row-gap: var(--space-xl); }
  /* A column ruler at the top of the hero shows the 12-column grid the page is built on. */
  .ruler { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; height: var(--space-sm); margin-bottom: var(--space-md); }
  .ruler span { border-left: 1px solid var(--color-rule-2); border-top: 1px solid var(--color-rule-2); }
  .ruler span:last-child { border-right: 1px solid var(--color-rule-2); }
  .label { grid-column: 1 / span 6; margin: 0; font-weight: 700; font-size: 0.875rem; letter-spacing: 0.02em; }
  .label::before { content: ""; display: inline-block; width: 0.625rem; height: 0.625rem; background: var(--color-accent); margin-right: var(--space-xs); }
  .hero__title { grid-column: 1 / span 11; margin: 0; font: 800 clamp(3rem, 7.2vw + 0.5rem, 7rem)/0.98 var(--font-display); letter-spacing: -0.035em; overflow-wrap: anywhere; min-width: 0; }
  .hero__side { grid-column: 7 / span 6; padding-top: var(--space-md); border-top: 2px solid var(--color-ink); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .hero__text { margin: 0; font-size: 1.25rem; line-height: 1.45; max-width: 40ch; }
  .hero__under { margin: 0; font-size: 1rem; color: var(--color-muted); }

  .problem { padding-block: var(--space-3xl); }
  .problem__title { grid-column: 1 / span 5; margin: 0; font: 800 clamp(1.75rem, 1.8vw + 1rem, 2.5rem)/1.08 var(--font-display); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .rows { grid-column: 7 / span 6; list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--color-ink); }
  .row { padding: var(--space-md) 0; border-bottom: 1px solid var(--color-rule-2); font-size: 1.1875rem; line-height: 1.4; }
  .row--strong { font-weight: 700; border-bottom: 2px solid var(--color-ink); }
  .message { grid-column: 7 / span 6; margin-top: var(--space-xl); }
  .message p { margin: 0 0 var(--space-xs); color: var(--color-neutral); }

  @media (max-width: 52rem) {
    .label, .hero__title, .hero__side, .problem__title, .rows, .message { grid-column: 1 / -1; }
    .problem__title { margin-bottom: var(--space-xl); }
    .ruler { display: none; }
  }
  @media (max-width: 30rem) {
    .bar .btn--small { display: none; }
    .hero .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
