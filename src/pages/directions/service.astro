---
// Direction 4: Service. Hallmark theme Coral (modern-minimal), two-column hero and a pinned problem section.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import Direction from "../../layouts/Direction.astro";
import { site, hero, problem, links } from "../../content/site";
---

<Direction direction="Service">
  <header class="nav">
    <div class="wrap nav__row">
      <a class="wordmark" href="#top">{site.name}</a>
      <a class="btn btn--small btn--outline" href={links.booking}>{site.bookButton}</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero__grid">
        <div>
          <p class="label">{hero.label}</p>
          <h1 class="hero__title">{hero.heading}</h1>
        </div>
        <div class="hero__side">
          <p class="hero__text">{hero.text}</p>
          <a class="btn" href={links.booking}>{site.bookButton}</a>
          <p class="hero__under">{hero.underButton}</p>
        </div>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="wrap problem__grid">
        <div class="problem__head">
          <h2 id="problem-title" class="problem__title">{problem.heading}</h2>
        </div>
        <div class="problem__body">
          <ul class="panel">
            {problem.symptoms.map((s) => <li>{s}</li>)}
          </ul>
          <div class="message">
            {problem.solution.map((line) => <p>{line}</p>)}
          </div>
        </div>
      </div>
    </section>
  </main>
</Direction>

<style is:global>
  /* Hallmark · genre: modern-minimal · macrostructure: Feature Stack (static, pinned head) · theme: Coral · enrichment: none · nav: N1a · footer: none (directions show hero and problem only) */
  :root {
    --color-paper: oklch(96.5% 0.005 50);
    --color-paper-2: oklch(94% 0.006 50);
    --color-surface: oklch(98.5% 0.004 50);
    --color-rule: oklch(86% 0.008 50);
    --color-rule-2: oklch(72% 0.010 50);
    --color-muted: oklch(48% 0.012 50);
    --color-neutral: oklch(38% 0.012 45);
    --color-ink: oklch(20% 0.010 35);
    --color-on-ink: oklch(98% 0.005 50);
    --color-accent: oklch(64% 0.165 28);
    --color-focus: oklch(50% 0.17 28);
    --font-display: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    --font-body: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    --font-label: "Geist Mono Variable", ui-monospace, monospace;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6.5rem;
    --page-max: 72rem;
    --page-gutter: clamp(1rem, 4vw, 3rem);
    --radius-card: 8px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--page-gutter); }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .nav__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: 4.5rem; }
  .wordmark { font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.015em; color: var(--color-ink); text-decoration: none; white-space: nowrap; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0 var(--space-lg); border-radius: 999px;
    background: var(--color-ink); color: var(--color-on-ink); border: 1px solid var(--color-ink);
    font: 500 1rem/1 var(--font-body); text-decoration: none; white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .btn:hover { background: var(--color-neutral); border-color: var(--color-neutral); }
  .btn:active { background: var(--color-ink); }
  .btn--small { min-height: 2.75rem; padding: 0 var(--space-md); font-size: 0.9375rem; }
  .btn--outline { background: transparent; color: var(--color-ink); border-color: var(--color-rule-2); }
  .btn--outline:hover { background: var(--color-surface); border-color: var(--color-ink); }

  .hero { padding-block: var(--space-2xl) var(--space-3xl); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: end; }
  .label { font: 400 0.8125rem/1.3 var(--font-label); letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 var(--space-lg); }
  .hero__title { font: 600 clamp(2.5rem, 4.6vw + 0.75rem, 4.5rem)/1.02 var(--font-display); letter-spacing: -0.035em; margin: 0; max-width: 12ch; overflow-wrap: anywhere; min-width: 0; }
  .hero__side { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-bottom: var(--space-xs); }
  .hero__text { margin: 0 0 var(--space-xs); font-size: 1.1875rem; line-height: 1.55; color: var(--color-neutral); max-width: 44ch; }
  .hero__under { margin: 0; font-size: 1rem; color: var(--color-muted); }

  .problem { background: var(--color-paper-2); border-top: 1px solid var(--color-rule); padding-block: var(--space-3xl); }
  .problem__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: var(--space-2xl); align-items: start; }
  .problem__head { position: sticky; top: var(--space-xl); }
  .problem__title { font: 600 clamp(1.75rem, 1.6vw + 1rem, 2.375rem)/1.15 var(--font-display); letter-spacing: -0.025em; margin: 0; overflow-wrap: anywhere; }
  .panel { list-style: none; margin: 0; padding: 0; background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-card); }
  .panel li { padding: var(--space-lg); font-size: 1.125rem; line-height: 1.45; }
  .panel li + li { border-top: 1px solid var(--color-rule); }
  .closing { font-weight: 600; font-size: 1.125rem; margin: var(--space-xl) 0 var(--space-md); }
  .message p { margin: 0 0 var(--space-xs); color: var(--color-neutral); max-width: 52ch; }

  @media (max-width: 52rem) {
    .hero__grid, .problem__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .problem__head { position: static; }
  }
  @media (max-width: 30rem) {
    .nav .btn--small { display: none; }
    .hero .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
