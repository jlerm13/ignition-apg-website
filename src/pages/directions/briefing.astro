---
// Direction 2: Briefing. Hallmark theme Specimen, macrostructure Long Document.
import "@fontsource-variable/fraunces";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import Direction from "../../layouts/Direction.astro";
import { site, hero, problem, links } from "../../content/site";
---

<Direction direction="Briefing">
  <header class="masthead">
    <div class="wrap masthead__row">
      <a class="wordmark" href="#top">{site.name}</a>
      <a class="btn btn--quiet" href={links.booking}>{site.bookButton}</a>
    </div>
  </header>

  <main id="top" class="wrap doc">
    <section class="hero">
      <p class="label">{hero.label}</p>
      <h1 class="hero__title">{hero.heading}</h1>
      <p class="hero__text">{hero.text}</p>
      <div class="hero__action">
        <a class="btn" href={links.booking}>{site.bookButton}</a>
        <p class="hero__under">{hero.underButton}</p>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <h2 id="problem-title" class="problem__title">{problem.heading}</h2>
      <ul class="symptoms">
        {problem.symptoms.map((s) => <li>{s}</li>)}
      </ul>
      <p class="closing">{problem.closingLine}</p>
      <div class="message">
        {problem.departmentMessage.map((line) => <p>{line}</p>)}
      </div>
    </section>
  </main>
</Direction>

<style is:global>
  /* Hallmark · genre: editorial · macrostructure: Long Document · theme: Specimen · enrichment: none · nav: N1a · footer: none (directions show hero and problem only) */
  :root {
    --color-paper: oklch(96% 0.018 80);
    --color-paper-2: oklch(93% 0.020 80);
    --color-rule: oklch(82% 0.014 75);
    --color-rule-2: oklch(70% 0.012 70);
    --color-muted: oklch(48% 0.012 65);
    --color-neutral: oklch(36% 0.014 60);
    --color-ink: oklch(18% 0.014 60);
    --color-on-ink: oklch(96% 0.018 80);
    --color-accent: #fc4c02;
    --color-accent-ink: oklch(55% 0.21 32);
    --color-focus: oklch(55% 0.21 32);
    --font-display: "Fraunces Variable", ui-serif, Georgia, serif;
    --font-body: "Geist Variable", ui-sans-serif, sans-serif;
    --font-label: "Geist Mono Variable", ui-monospace, monospace;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2.5rem;
    --space-2xl: 4rem;
    --space-3xl: 6.5rem;
    --page-max: 76rem;
    --page-gutter: clamp(1rem, 4vw, 3rem);
    --measure: 62ch;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--page-gutter); }
  :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }

  .masthead { border-bottom: 3px double var(--color-rule-2); }
  .masthead__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: 4.5rem; }
  .wordmark { font: 500 1.375rem/1 var(--font-display); color: var(--color-ink); text-decoration: none; white-space: nowrap; font-variation-settings: "opsz" 72; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0 var(--space-lg);
    background: var(--color-ink); color: var(--color-on-ink); border: 1px solid var(--color-ink);
    font: 500 1rem/1 var(--font-body); text-decoration: none; white-space: nowrap;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .btn:hover { background: var(--color-paper); color: var(--color-ink); }
  .btn:active { background: var(--color-paper-2); color: var(--color-ink); }
  .btn--quiet { min-height: 2.75rem; padding: 0 var(--space-md); background: transparent; color: var(--color-ink); font-size: 0.9375rem; }
  .btn--quiet:hover { background: var(--color-ink); color: var(--color-on-ink); }

  /* The document column sits right of centre, so the page reads like a memo, not a template hero. */
  .doc { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); }
  .doc > section { grid-column: 2; }

  .hero { padding-block: var(--space-3xl) var(--space-3xl); border-bottom: 1px solid var(--color-rule); }
  .label { font: 400 0.8125rem/1.3 var(--font-label); letter-spacing: 0.04em; color: var(--color-muted); margin: 0 0 var(--space-lg); }
  .label::before { content: ""; display: inline-block; width: 0.5rem; height: 0.5rem; background: var(--color-accent); margin-right: var(--space-sm); vertical-align: 0.05em; }
  .hero__title { font: 340 clamp(2.75rem, 5vw + 1rem, 5.25rem)/1.02 var(--font-display); font-variation-settings: "opsz" 144, "SOFT" 20; letter-spacing: -0.025em; margin: 0; max-width: 13ch; overflow-wrap: anywhere; min-width: 0; }
  .hero__text { font-size: 1.25rem; line-height: 1.55; color: var(--color-neutral); max-width: 46ch; margin: var(--space-xl) 0; }
  .hero__action { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
  .hero__under { margin: 0; font-size: 1rem; color: var(--color-muted); max-width: 30ch; }

  .problem { padding-block: var(--space-3xl) var(--space-3xl); max-width: var(--measure); }
  .problem__title { font: 400 clamp(1.875rem, 2vw + 1rem, 2.75rem)/1.15 var(--font-display); font-variation-settings: "opsz" 72; letter-spacing: -0.015em; margin: 0 0 var(--space-xl); overflow-wrap: anywhere; }
  .symptoms { list-style: none; margin: 0; padding: 0; }
  .symptoms li { padding: var(--space-md) 0; border-top: 1px solid var(--color-rule); font-size: 1.1875rem; line-height: 1.5; }
  .symptoms li:last-child { border-bottom: 1px solid var(--color-rule); }
  .closing { font: 400 1.375rem/1.4 var(--font-display); font-variation-settings: "opsz" 48; margin: var(--space-xl) 0; }
  .message p { margin: 0 0 var(--space-xs); color: var(--color-neutral); }
  .message p:first-child { font-weight: 600; color: var(--color-ink); }

  @media (max-width: 52rem) {
    .doc { grid-template-columns: minmax(0, 1fr); }
    .doc > section { grid-column: 1; }
    .hero { padding-top: var(--space-2xl); }
  }
  @media (max-width: 30rem) {
    .masthead .btn--quiet { display: none; }
    .hero .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
