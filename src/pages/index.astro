---
// The Ignition APG home page. Design: docs/DESIGN.md. Words: src/content/site.ts.
import Base from "../layouts/Base.astro";
import {
  site, links, hero, problem, handUs, staysWithStaff, howItStarts, questions, whoWeAre, finalCall,
} from "../content/site";
---

<Base>
  <!-- 1. Hero: marquee heading over the column ruler. -->
  <section class="border-b border-rule-2 pt-10 pb-16 md:pt-16 md:pb-26" aria-labelledby="hero-title">
    <div class="wrap grid-12 gap-y-10">
      <div class="ruler max-md:hidden" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>
      <p class="marker col-span-12 font-bold md:col-span-6">{hero.label}</p>
      <h1 id="hero-title" class="col-span-12 text-display leading-[0.98] font-extrabold tracking-[-0.035em] md:col-span-11">{hero.heading}</h1>
      <div class="col-span-12 flex flex-col items-start gap-4 border-t-2 border-ink pt-4 md:col-start-7 md:col-span-6">
        <p class="max-w-[40ch] text-lead leading-[1.45]">{hero.text}</p>
        <a class="btn max-[30rem]:w-full" href={links.booking} data-event="cta_click" data-section="hero">{site.bookButton}</a>
        <p class="text-muted">{hero.underButton}</p>
      </div>
    </div>
  </section>

  <!-- 2. Problem: heading left, symptom rows right. -->
  <section class="py-16 md:py-26" aria-labelledby="problem-title">
    <div class="wrap grid-12 gap-y-10">
      <h2 id="problem-title" class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] md:col-span-5">{problem.heading}</h2>
      <div class="col-span-12 md:col-start-7 md:col-span-6">
        <ul class="border-t-2 border-ink">
          {problem.symptoms.map((s) => <li class="border-b border-rule-2 py-4 text-item leading-[1.4]">{s}</li>)}
        </ul>
        <p class="border-b-2 border-ink py-4 text-item leading-[1.4] font-bold">{problem.closingLine}</p>
        <div class="mt-10 space-y-2 text-neutral">
          {problem.departmentMessage.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What you can hand us: heading on top, four verb groups in a two by two grid. -->
  <section class="border-t border-rule-2 bg-paper-2 py-16 md:py-26" aria-labelledby="hand-title">
    <div class="wrap">
      <div class="max-w-[48rem]">
        <h2 id="hand-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{handUs.heading}</h2>
        <p class="mt-4 max-w-[52ch] text-lead leading-[1.45] text-neutral">{handUs.text}</p>
      </div>
      <div class="mt-16 grid gap-x-16 gap-y-10 md:grid-cols-2">
        {handUs.groups.map((g) => (
          <div class="border-t-2 border-ink pt-4">
            <h3 class="text-lead font-extrabold tracking-[-0.01em]">{g.verb}</h3>
            <ul class="mt-4 space-y-4">
              {g.items.map((item) => <li class="marker text-item leading-[1.4]" data-claim="hand-us">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. What stays with your staff: the one ink band. -->
  <section class="bg-ink py-16 text-on-ink md:py-26" aria-labelledby="stays-title">
    <div class="wrap grid-12 gap-y-10">
      <div class="col-span-12 md:col-span-5">
        <h2 id="stays-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{staysWithStaff.heading}</h2>
        <p class="mt-4 max-w-[40ch] text-lead leading-[1.45] text-on-ink-muted">{staysWithStaff.text}</p>
      </div>
      <ul class="col-span-12 grid gap-x-10 sm:grid-cols-2 md:col-start-7 md:col-span-6">
        {staysWithStaff.items.map((item) => <li class="border-t border-ink-2 py-4 text-item leading-[1.4]" data-claim="stays">{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- 5. How it starts: three steps in columns divided by hairlines. -->
  <section class="py-16 md:py-26" aria-labelledby="start-title">
    <div class="wrap">
      <h2 id="start-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{howItStarts.heading}</h2>
      <!-- deslop-ignore-next-line 28: three plain text steps in sentence case, not an all-caps card grid -->
      <ol class="mt-10 grid border-y-2 border-ink md:grid-cols-3">
        {howItStarts.steps.map((step) => (
          <li class="border-rule-2 py-6 max-md:not-last:border-b md:px-6 md:first:pl-0 md:not-last:border-r">
            <h3 class="text-lead font-extrabold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-3 max-w-[36ch] text-neutral">{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[60ch] font-bold">{howItStarts.closingLine}</p>
    </div>
  </section>

  <!-- 6. Questions: native details, no script. -->
  <section class="border-t border-rule-2 bg-paper-2 py-16 md:py-26" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{questions.heading}</h2>
      <div class="faq mt-10 max-w-[52rem] border-t-2 border-ink">
        {questions.items.map((item) => (
          <details class="border-b border-rule-2">
            <summary>{item.q}</summary>
            <p class="max-w-[60ch] pb-6 text-neutral">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Who we are: a short statement set large. -->
  <section class="py-16 md:py-26" aria-labelledby="who-title">
    <div class="wrap grid-12">
      <div class="col-span-12 md:col-span-9">
        <h2 id="who-title" class="text-lead font-extrabold">{whoWeAre.heading}</h2>
        <div class="mt-4 space-y-4 text-[clamp(1.375rem,1.2vw+1rem,1.875rem)] leading-[1.3] font-semibold tracking-[-0.01em]">
          {whoWeAre.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Final call to action. -->
  <section class="border-t-2 border-ink py-16 md:py-26" aria-labelledby="final-title">
    <div class="wrap">
      <h2 id="final-title" class="max-w-[18ch] text-final leading-[1.02] font-extrabold tracking-[-0.03em]">{finalCall.heading}</h2>
      <div class="mt-10 flex flex-col items-start gap-4">
        <a class="btn max-[30rem]:w-full" href={links.booking} data-event="cta_click" data-section="final">{site.bookButton}</a>
        <p class="text-neutral">
          {finalCall.emailLine}{" "}
          <a class="link link--inline break-all" href={`mailto:${links.email}`} data-event="email_click" data-section="final">{links.email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
