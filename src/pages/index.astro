---
// The Ignition APG home page. Design: docs/DESIGN.md. Words: src/content/site.ts.
import Base from "../layouts/Base.astro";
import {
  site, links, hero, rolePicker, problem, outcomes, chain, specialist, staysWithStaff, howItStarts, questions, whoWeAre, finalCall,
} from "../content/site";

// Keep "return-to-play" on one line wherever it appears (the words stay as approved).
const TERM = "return-to-play";
const split = (text: string) => text.split(TERM);

// Calendly fills the first booking question (the role, a1) from the link. See docs/BOOKING.md.
const roleLink = (role: string) => `${links.booking}?a1=${encodeURIComponent(role)}`;
---

<Base>
  <!-- 1. Hero: marquee heading over the column ruler. -->
  <section class="border-b border-rule-2 pt-10 pb-16 md:pt-16 md:pb-26" aria-labelledby="hero-title">
    <div class="wrap grid-12 gap-y-10">
      <div class="ruler max-md:hidden" aria-hidden="true">{Array.from({ length: 12 }, () => <span />)}</div>
      <p class="marker col-span-12 font-bold md:col-span-6">{hero.label}</p>
      <h1 id="hero-title" class="col-span-12 text-display leading-[0.98] font-extrabold tracking-[-0.035em] md:col-span-11">{hero.heading}</h1>
      <!-- Wide screens: the explanation left, the role picker right, both on a 2 px rule. Same order in the code as on phones. -->
      <div class="col-span-12 border-t-2 border-ink pt-4 lg:col-span-5">
        <p class="max-w-[46ch] text-lead leading-[1.45] lg:max-w-[30ch] lg:text-[clamp(1.25rem,0.6vw+1rem,1.5rem)]">{hero.text}</p>
      </div>
      <div class="col-span-12 flex flex-col items-start gap-4 lg:col-start-7 lg:col-span-6">
        <!-- Three taps: role, what takes the most time, who handles it. The bar has no numbers. Without script, a role opens Calendly at once. -->
        <div class="w-full" data-picker data-booking={links.booking}>
          <div class="progress" aria-hidden="true"><span data-on></span><span></span><span></span></div>
          <div data-step="role" class="pt-4">
            <p id="step-role-prompt" class="font-bold" tabindex="-1">{rolePicker.prompt}</p>
            <p class="mt-1 text-muted">{rolePicker.hint}</p>
            <ul class="mt-3 grid gap-2" aria-labelledby="step-role-prompt">
              {rolePicker.roles.map((role) => (
                <li><a class="btn btn--choice w-full" href={roleLink(role)} data-pick-role={role}>{role}</a></li>
              ))}
            </ul>
            <p class="mt-3"><a class="link inline-flex min-h-11 items-center" href={links.booking} data-event="cta_click" data-section="hero" data-role="other">{rolePicker.otherLink}</a></p>
          </div>
          <div data-step="problem" class="pt-4" hidden>
            <p id="step-problem-prompt" class="font-bold" tabindex="-1">{rolePicker.problem.prompt}</p>
            <p class="mt-1 text-muted">{rolePicker.problem.hint}</p>
            <ul class="mt-3 grid gap-2" aria-labelledby="step-problem-prompt">
              {rolePicker.problem.choices.map((choice) => (
                <li><a class="btn btn--choice w-full" href={links.booking} data-pick-problem={choice}>{choice}</a></li>
              ))}
              <li><a class="btn btn--choice w-full" href={links.booking} data-pick-problem="">{rolePicker.problem.other}</a></li>
            </ul>
            <p class="mt-3"><button type="button" class="link inline-flex min-h-11 cursor-pointer items-center" data-back>{rolePicker.back}</button></p>
          </div>
          <div data-step="owner" class="pt-4" hidden>
            <p id="step-owner-prompt" class="font-bold" tabindex="-1">{rolePicker.owner.prompt}</p>
            <p class="mt-1 text-muted">{rolePicker.owner.hint}</p>
            <ul class="mt-3 grid gap-2" aria-labelledby="step-owner-prompt">
              {rolePicker.owner.choices.map((choice) => (
                <li><a class="btn btn--choice w-full" href={links.booking} data-event="cta_click" data-section="hero" data-pick-owner={choice}>{choice}</a></li>
              ))}
            </ul>
            <p class="mt-3"><button type="button" class="link inline-flex min-h-11 cursor-pointer items-center" data-back>{rolePicker.back}</button></p>
          </div>
        </div>
        <p class="text-muted">{hero.underButton}</p>
      </div>
    </div>
  </section>

  <script is:inline>
    // Hero picker: one question at a time, then open Calendly with the answers filled in.
    // Calendly fills its booking questions from ?a1= (role), ?a3= (problem), and ?a4= (who handles it). See docs/BOOKING.md.
    (function () {
      var picker = document.querySelector("[data-picker]");
      if (!picker) return;
      var booking = picker.getAttribute("data-booking");
      var steps = ["role", "problem", "owner"].map(function (name) { return picker.querySelector('[data-step="' + name + '"]'); });
      var bars = picker.querySelectorAll(".progress span");
      var answers = { role: "", problem: "" };
      function show(index) {
        steps.forEach(function (step, i) { step.hidden = i !== index; });
        bars.forEach(function (bar, i) { if (i <= index) bar.setAttribute("data-on", ""); else bar.removeAttribute("data-on"); });
        steps[index].querySelector("[tabindex]").focus();
      }
      steps[0].querySelectorAll("[data-pick-role]").forEach(function (a) {
        a.addEventListener("click", function (e) {
          e.preventDefault();
          answers.role = a.getAttribute("data-pick-role");
          show(1);
        });
      });
      steps[1].querySelectorAll("[data-pick-problem]").forEach(function (a) {
        a.addEventListener("click", function (e) {
          e.preventDefault();
          answers.problem = a.getAttribute("data-pick-problem");
          show(2);
        });
      });
      steps[2].querySelectorAll("[data-pick-owner]").forEach(function (a) {
        a.addEventListener("click", function () {
          var url = booking + "?a1=" + encodeURIComponent(answers.role);
          if (answers.problem) url += "&a3=" + encodeURIComponent(answers.problem);
          url += "&a4=" + encodeURIComponent(a.getAttribute("data-pick-owner"));
          a.href = url;
          a.setAttribute("data-role", answers.role);
        });
      });
      picker.querySelectorAll("[data-back]").forEach(function (button) {
        button.addEventListener("click", function () { show(steps.indexOf(button.closest("[data-step]")) - 1); });
      });
    })();
  </script>

  <!-- 2. Problem: heading left, symptom rows right, then the contrast with well-resourced programs. -->
  <section class="py-16 md:py-26" aria-labelledby="problem-title">
    <div class="wrap grid-12 gap-y-10">
      <h2 id="problem-title" class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] lg:sticky lg:top-24 lg:col-span-5 lg:self-start">{problem.heading}</h2>
      <div class="col-span-12 lg:col-start-7 lg:col-span-6">
        <ul class="border-y-2 border-ink">
          {problem.symptoms.map((s) => <li class="border-b border-rule-2 py-4 text-item leading-[1.4] last:border-b-0">{s}</li>)}
        </ul>
        <div class="mt-10 space-y-3 text-lead leading-[1.45]">
          {problem.contrast.map((line, i) => <p class={i === 0 ? "font-bold" : "text-neutral"}>{line}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. What changes for your staff: three ruled rows, the outcome left and its supporting line right, then the booking button. -->
  <section class="border-t border-rule-2 py-16 md:py-26" aria-labelledby="outcomes-title">
    <div class="wrap">
      <h2 id="outcomes-title" class="text-lead font-extrabold tracking-[-0.01em]">{outcomes.heading}</h2>
      <ul class="mt-6 border-y-2 border-ink">
        {outcomes.items.map((item) => (
          <li class="grid-12 gap-y-3 border-rule-2 py-6 not-last:border-b lg:items-baseline lg:py-10">
            <h3 class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] lg:col-span-6">{item.title}</h3>
            <p class="col-span-12 text-lead leading-[1.45] lg:col-start-8 lg:col-span-5">{item.text}</p>
          </li>
        ))}
      </ul>
      <a class="btn mt-10 max-[30rem]:w-full" href={links.booking} data-event="cta_click" data-section="outcomes">{site.bookButton}</a>
    </div>
  </section>

  <!-- 3. The chain: who owns each part of the work. The two ends belong to the staff, the middle to the specialist.
       The four middle lines are the "What you can hand us" claims (scripts/check-claims.mjs). No numbers, labelled "Illustration". -->
  <section class="border-t border-rule-2 bg-paper-2 py-16 md:py-26" aria-labelledby="chain-title">
    <div class="wrap">
      <div class="grid-12 gap-y-4">
        <h2 id="chain-title" class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] lg:col-span-5">{chain.heading}</h2>
        <div class="col-span-12 max-w-[46ch] space-y-3 text-lead leading-[1.45] lg:col-start-7 lg:col-span-6">
          {chain.text.map((line, i) => <p class={i === 0 ? "font-bold" : "text-neutral"}>{line}</p>)}
        </div>
      </div>
      <figure class="mt-10">
        <div class="chain grid-12 gap-y-10">
          <div class="chain-part col-span-12 lg:col-span-3">
            <p class="chain-owner">{chain.staff}</p>
            <h3 class="mt-4 text-lead font-extrabold tracking-[-0.01em]">{chain.start.title}</h3>
            <p class="mt-2 text-neutral">{chain.start.text}</p>
          </div>
          <div class="chain-part chain-part--ours col-span-12 lg:col-span-6">
            <p class="chain-owner">{chain.specialist}</p>
            <ol class="mt-4">
              {chain.steps.map((step) => (
                <li class="border-rule-2 py-4 not-last:border-b first:pt-0 last:pb-0 sm:grid sm:grid-cols-[7rem_1fr] sm:gap-x-6">
                  <h3 class="text-lead font-extrabold tracking-[-0.01em]">{step.verb}</h3>
                  <p class="text-item leading-[1.4] max-sm:mt-1" data-claim="hand-us">{step.text}</p>
                </li>
              ))}
            </ol>
          </div>
          <div class="chain-part col-span-12 lg:col-span-3">
            <p class="chain-owner">{chain.staff}</p>
            <h3 class="mt-4 text-lead font-extrabold tracking-[-0.01em]">{chain.end.title}</h3>
            <p class="mt-2 text-neutral">{chain.end.text}</p>
          </div>
        </div>
        <figcaption class="mt-10 border-t border-rule-2 pt-3 text-[1rem] text-muted">{chain.caption}</figcaption>
      </figure>
      <p class="mt-6 font-bold">{chain.closingLine}</p>
    </div>
  </section>

  <!-- 3b. Performance data specialist: a role, no person. Heading left, who and a week right. -->
  <section class="py-16 md:py-26" aria-labelledby="specialist-title">
    <div class="wrap grid-12 gap-y-10">
      <div class="col-span-12 lg:sticky lg:top-24 lg:col-span-5 lg:self-start">
        <h2 id="specialist-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{specialist.heading}</h2>
        <div class="mt-4 max-w-[46ch] space-y-3 text-lead leading-[1.45] text-neutral">
          {specialist.text.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="col-span-12 space-y-10 lg:col-start-7 lg:col-span-6">
        <div class="border-t-2 border-ink pt-4">
          <h3 class="text-lead font-extrabold tracking-[-0.01em]">{specialist.who.heading}</h3>
          <ul class="mt-2 space-y-3">
            {specialist.who.items.map((item) => <li class="text-item leading-[1.4]">{item}</li>)}
          </ul>
        </div>
        <div class="border-t-2 border-ink pt-4">
          <h3 class="text-lead font-extrabold tracking-[-0.01em]">{specialist.week.heading}</h3>
          <ol class="week mt-2">
            {specialist.week.items.map((item) => <li class="text-item leading-[1.4]">{item}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. What stays with your staff: the one ink band. The six lines carry their own label. "What we are not" is a separate row below. -->
  <section class="bg-ink py-16 text-on-ink md:py-26" aria-labelledby="stays-title">
    <div class="wrap">
      <div class="grid-12 gap-y-10">
        <div class="col-span-12 lg:col-span-5">
          <h2 id="stays-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{staysWithStaff.heading}</h2>
          <p class="mt-4 max-w-[46ch] text-lead leading-[1.45] text-on-ink-muted">{staysWithStaff.text}</p>
        </div>
        <div class="col-span-12 lg:col-start-7 lg:col-span-6">
          <h3 id="stays-list" class="text-lead font-extrabold tracking-[-0.01em]">{staysWithStaff.listLabel}</h3>
          <ul class="mt-4 grid gap-x-10 sm:grid-cols-2" aria-labelledby="stays-list">
            {staysWithStaff.items.map((item) => (
              <li class="border-t border-ink-2 py-4 text-item leading-[1.4]" data-claim="stays">
                {split(item).map((part, i, all) => <>{part}{i < all.length - 1 && <span class="whitespace-nowrap">{TERM}</span>}</>)}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="mt-16 border-t-2 border-on-ink pt-6">
        <h3 id="not-list" class="text-lead font-extrabold tracking-[-0.01em]">{staysWithStaff.not.heading}</h3>
        <ul class="mt-4" aria-labelledby="not-list">
          {staysWithStaff.not.items.map((item) => (
            <li class="grid-12 gap-y-1 border-t border-ink-2 py-4">
              <p class="col-span-12 text-lead font-extrabold tracking-[-0.01em] lg:col-span-5">{item.label}</p>
              <p class="col-span-12 text-item leading-[1.4] lg:col-start-7 lg:col-span-6">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. How it starts: three steps in columns divided by hairlines. -->
  <section class="py-16 md:py-26" aria-labelledby="start-title">
    <div class="wrap">
      <h2 id="start-title" class="text-section leading-[1.08] font-extrabold tracking-[-0.02em]">{howItStarts.heading}</h2>
      <!-- deslop-ignore-next-line 28: three plain text steps in sentence case, not an all-caps card grid -->
      <ol class="mt-10 grid border-y-2 border-ink md:grid-cols-3">
        {howItStarts.steps.map((step) => (
          <li class="border-rule-2 py-6 max-md:not-last:border-b md:px-6 md:first:pl-0 md:not-last:border-r">
            <h3 class="text-lead font-extrabold tracking-[-0.01em]">{step.title}</h3>
            <p class="mt-3 text-neutral">{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[60ch] font-bold">{howItStarts.closingLine}</p>
      <a class="btn mt-10 max-[30rem]:w-full" href={links.booking} data-event="cta_click" data-section="how-it-starts">{site.bookButton}</a>
    </div>
  </section>

  <!-- 6. Questions: heading left, native details right, all closed on load. -->
  <section class="border-t border-rule-2 bg-paper-2 py-16 md:py-26" aria-labelledby="faq-title">
    <div class="wrap grid-12 gap-y-10">
      <h2 id="faq-title" class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] lg:col-span-5">{questions.heading}</h2>
      <div class="faq col-span-12 border-t-2 border-ink lg:col-start-7 lg:col-span-6">
        {questions.items.map((item) => (
          <details class="border-b border-rule-2">
            <summary>{item.q}</summary>
            <p class="pb-6 text-neutral">
              {split(item.a).map((part, i, all) => <>{part}{i < all.length - 1 && <span class="whitespace-nowrap">{TERM}</span>}</>)}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Who we are: heading left (sticky on wide screens), five paragraphs right. -->
  <section class="py-16 md:py-26" aria-labelledby="who-title">
    <div class="wrap grid-12 gap-y-10">
      <h2 id="who-title" class="col-span-12 text-section leading-[1.08] font-extrabold tracking-[-0.02em] lg:sticky lg:top-24 lg:col-span-5 lg:self-start">{whoWeAre.heading}</h2>
      <div class="col-span-12 space-y-4 text-lead leading-[1.45] lg:col-start-7 lg:col-span-6">
        {whoWeAre.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- 8. Final call to action. -->
  <section class="border-t-2 border-ink py-16 md:py-26" aria-labelledby="final-title">
    <div class="wrap">
      <h2 id="final-title" class="max-w-[18ch] text-final leading-[1.02] font-extrabold tracking-[-0.03em]">{finalCall.heading}</h2>
      <div class="mt-10 flex flex-col items-start gap-4">
        <a class="btn max-[30rem]:w-full" href={links.booking} data-event="cta_click" data-section="final">{site.bookButton}</a>
        <p class="text-neutral">
          {finalCall.emailLine}{" "}
          <a class="link link--inline whitespace-nowrap" href={`mailto:${links.email}`} data-event="email_click" data-section="final">{links.email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
