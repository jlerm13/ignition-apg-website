---
// Shell for the Stage 2 design directions. Directions show the hero and the
// problem section only, with the approved copy from src/content/site.ts.
// They are review pages for Jake, so search engines must not index them.
import { site } from "../content/site";

interface Props {
  direction: string;
}
const { direction } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${direction} · ${site.pageTitle}`}</title>
    <meta name="description" content={site.description} />
  </head>
  <body>
    <slot />
  </body>
</html>
