---
import { site, links } from "../content/site";
interface Props { button?: boolean }
const { button = true } = Astro.props;
---

<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper">
  <div class="wrap flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="inline-flex min-h-11 items-center text-lg font-extrabold tracking-tight whitespace-nowrap text-ink no-underline transition-colors duration-150 hover:text-neutral active:text-muted">{site.name}</a>
    {button && (
      <a class="btn btn--small max-[30rem]:hidden" href={links.booking} data-event="cta_click" data-section="header">{site.bookButton}</a>
    )}
  </div>
</header>
